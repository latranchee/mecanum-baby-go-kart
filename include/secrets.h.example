#pragma once
#include <stdint.h>

// Copy this file to secrets.h and fill in your values. secrets.h is gitignored.
// protocol.h includes secrets.h automatically when present (#if __has_include).

// Robot's STA MAC. Print it once from the robot serial log ("Robot MAC: ...").
static const uint8_t ROBOT_MAC[6] = { 0xDE, 0xAD, 0xBE, 0xEF, 0x00, 0x01 };

// Controller's STA MAC ("Controller MAC: ..." in its serial log). Used only when
// ESPNOW_ENCRYPT=1 (robot registers the controller as an encrypted peer).
static const uint8_t CONTROLLER_MAC[6] = { 0xDE, 0xAD, 0xBE, 0xEF, 0x00, 0x02 };

// ESP-NOW encryption keys (only used when ESPNOW_ENCRYPT=1, Phase 5). Both keys
// are exactly 16 bytes. MUST be identical on robot and controller, or the link
// silently dies. Generate fresh random bytes for a real deployment.
static const uint8_t ESPNOW_PMK[16] = {
  0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
  0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F,
};
static const uint8_t ESPNOW_LMK[16] = {
  0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
  0x18, 0x19, 0x1A, 0x1B, 0x1C, 0x1D, 0x1E, 0x1F,
};

// Unused by current firmware; kept for possible future WiFi/OTA/MQTT use.
#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-wifi-password"

#define OTA_HOSTNAME  "mecanum"
#define OTA_PASSWORD  "your-ota-password"
